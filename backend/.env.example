# MachineMind AI Backend Environment Configuration
PROJECT_NAME="MachineMind AI Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
# For production PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/machinemind
# For local zero-setup development: sqlite:///./machinemind.db
DATABASE_URL="sqlite:///./machinemind.db"

# JWT Authentication
SECRET_KEY="machinemind-ai-super-secret-cryptographic-hashing-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:4173,https://machinemind-ai.vercel.app,https://machine-mind-ai.vercel.app"

# Industrial Telemetry Simulation
DEFAULT_SIMULATION_HZ=1.0
TELEMETRY_NOISE_SIGMA=0.08

# Email Reset (Development fallback or SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@machinemind.ai"
